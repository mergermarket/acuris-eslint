{
  "name": "@acuris/eslint-config",
  "version": "0.2.0",
  "private": false,
  "description": "Acuris eslint shareable configuration",
  "keywords": [
    "acuris-eslint",
    "acuris",
    "eslint",
    "prettier"
  ],
  "license": "MIT",
  "author": "Acuris, Salvatore Previti",
  "homepage": "https://github.com/mergermarket/acuris-eslint#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mergermarket/acuris-eslint.git"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "index.js",
  "bin": {
    "acuris-eslint": "bin/acuris-eslint.js"
  },
  "scripts": {
    "lint": "node scripts/acuris-eslint.js",
    "help": "node scripts/acuris-eslint.js --help",
    "acuris-eslint": "node scripts/acuris-eslint.js",
    "postinstall": "node ./scripts/postinstall.js",
    "test": "mocha \"test/**/*.test.js\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*": [
      "npm run acuris-eslint --lint-staged --fix --max-warnings=0"
    ]
  },
  "bundleDependencies": [
    "chalk",
    "comment-json",
    "ignore",
    "semver",
    "v8-compile-cache"
  ],
  "peerDependencies": {
    "eslint": ">=8.56.0",
    "eslint-plugin-import": ">=2.29.1",
    "eslint-plugin-json": ">=3.1.0",
    "eslint-plugin-node": ">=11.1.0",
    "eslint-plugin-promise": ">=6.1.1",
    "prettier": ">=3.2.5"
  },
  "dependencies": {
    "chalk": "^4.1.0",
    "comment-json": "^4.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "ignore": "^5.1.8",
    "semver": "^7.3.2",
    "v8-compile-cache": "2.1.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.10",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.17",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "chai": "^4.4.1",
    "eslint": "^8.56.0",
    "eslint-import-resolver-parcel": "^1.10.6",
    "eslint-plugin-chai-expect": "^3.0.0",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.8.0",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-mocha": "^10.2.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-scope": "^8.0.0",
    "husky": "^4.3.0",
    "jest": "^29.7.0",
    "lint-staged": "^10.4.2",
    "mocha": "^10.3.0",
    "mock-fs": "^5.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
